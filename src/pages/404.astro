---
import Base from '../layouts/Base.astro'
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---

<Base title="Página não encontrada · IMar Júnior">
  <div class="nf wrap">
    <p class="eyebrow">Erro 404 · fossa abissal</p>
    <h1 class="h2">Você mergulhou <em>fundo demais</em>.</h1>
    <p class="lead">Esta página não existe, ou foi levada pela correnteza.</p>
    <a class="btn btn--primary" href={base}>Voltar à superfície</a>
  </div>
</Base>

<style>
  .nf { min-height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 8px; }
  .nf .btn { margin-top: 32px; }
</style>
