---
/* Página inicial (landing): resumo de tudo, com botões para as outras páginas. */
import Base from '../layouts/Base.astro'
import Hero from '../components/Hero.astro'
import Parceiros from '../components/Parceiros.astro'
import Servicos from '../components/Servicos.astro'
import Numeros from '../components/Numeros.astro'
import Projetos from '../components/Projetos.astro'
import PorQueResumo from '../components/PorQueResumo.astro'
import Ods from '../components/Ods.astro'
import CtaFinal from '../components/CtaFinal.astro'
---

<Base>
  <Hero />
  <Parceiros />
  <Servicos />
  <Numeros />
  <Projetos modo="destaque" />
  <PorQueResumo />
  <Ods />
  <CtaFinal titulo="Vamos construir um projeto juntos?" />
</Base>
