---
/* Transição entre páginas: uma onda azul sobe cobrindo a tela e depois sai por cima. */
import { base } from '../lib/rotas'
const crista = 'M0 44 Q 180 4 360 40 T 720 40 T 1080 40 T 1440 40 L1440 80 L0 80 Z'
const vale = 'M0 0 L1440 0 L1440 36 Q 1260 76 1080 40 T 720 40 T 360 40 T 0 40 Z'
---

<div class="onda" data-onda aria-hidden="true">
  <div class="onda__p onda__p--a">
    <svg class="onda__topo" viewBox="0 0 1440 80" preserveAspectRatio="none"><path d={crista} /></svg>
    <svg class="onda__base" viewBox="0 0 1440 80" preserveAspectRatio="none"><path d={vale} /></svg>
  </div>
  <div class="onda__p onda__p--b">
    <svg class="onda__topo" viewBox="0 0 1440 80" preserveAspectRatio="none"><path d={crista} /></svg>
    <svg class="onda__base" viewBox="0 0 1440 80" preserveAspectRatio="none"><path d={vale} /></svg>
    <img src={`${base}img/logo.png`} alt="" width="88" height="88" />
  </div>
</div>

<style>
  .onda { position: fixed; inset: 0; z-index: 950; pointer-events: none; overflow: hidden; }
  .onda__p { position: absolute; inset: 0; transform: translateY(115%); will-change: transform; }
  .onda__p--a { background: var(--accent); fill: var(--accent); }
  .onda__p--b { background: var(--bg-1); fill: var(--bg-1); display: grid; place-items: center; }
  .onda__p img { width: 88px; height: 88px; opacity: .9; }
  .onda svg { position: absolute; left: 0; width: 100%; height: 80px; }
  .onda__topo { bottom: calc(100% - 1px); }
  .onda__base { top: calc(100% - 1px); }

  /* Chegando de outra página: começa cobrindo (com segurança caso o JS falhe) */
  :global(.onda-entrando) .onda__p { transform: translateY(0); animation: onda-safe 0s 3s forwards; }
  :global(.onda-saindo) .onda { pointer-events: auto; }
  @keyframes onda-safe { to { transform: translateY(-120%); } }
</style>
