---
/* Ícones de linha usados no site. Uso: <Icon name="seta" /> */
interface Props {
  name: 'seta' | 'seta-baixo' | 'seta-cima' | 'whatsapp' | 'instagram' | 'linkedin' | 'tiktok' | 'email' | 'sol' | 'lua' | 'menu' | 'fechar'
  size?: number
  class?: string
}
const { name, size = 18, class: cls } = Astro.props
---

<svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'seta' && <path d="M7 17 17 7M8 7h9v9" />}
  {name === 'seta-baixo' && <path d="M12 5v14M6 13l6 6 6-6" />}
  {name === 'seta-cima' && <path d="M12 19V5M6 11l6-6 6 6" />}
  {name === 'whatsapp' && (
    <>
      <path d="M3.5 20.5 5 16a8.5 8.5 0 1 1 3.2 3.1Z" />
      <path d="M9 9.2c.2 2.6 2.7 5.1 5.4 5.6l1.3-1.3-1.9-1-1 .7c-1-.5-1.8-1.3-2.3-2.3l.7-1-1-1.9Z" />
    </>
  )}
  {name === 'instagram' && (
    <>
      <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.3" cy="6.7" r=".6" fill="currentColor" />
    </>
  )}
  {name === 'linkedin' && (
    <>
      <rect x="3.5" y="3.5" width="17" height="17" rx="3" />
      <path d="M8 10.5V16M8 8v.01M11.5 16v-5.5M11.5 13c0-1.6 1-2.6 2.3-2.6s2.2.9 2.2 2.6V16" />
    </>
  )}
  {name === 'tiktok' && <path d="M14 4v10.5a3.5 3.5 0 1 1-3.5-3.5M14 4c.4 2.4 2.1 4 4.5 4.2" />}
  {name === 'email' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="3" />
      <path d="m4 7 8 6 8-6" />
    </>
  )}
  {name === 'sol' && (
    <>
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
    </>
  )}
  {name === 'lua' && <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z" />}
  {name === 'menu' && <path d="M4 8h16M4 16h16" />}
  {name === 'fechar' && <path d="M6 6l12 12M18 6 6 18" />}
</svg>
