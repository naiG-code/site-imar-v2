---
import Icon from './Icon.astro'
import { site } from '../data/site'

const ano = new Date().getFullYear()
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---

<footer class="foot">
  <svg class="foot__wave" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
    <path data-foot-wave d="M0 60 C 240 20 480 100 720 60 S 1200 20 1440 60 L1440 120 L0 120 Z" />
  </svg>

  <div class="wrap">
    <div class="foot__top">
      <div>
        <p class="foot__slogan">Mude o mundo fazendo as <em>escolhas certas</em>.</p>
        <a class="btn btn--ghost" href="#topo" data-to-top data-magnetic><Icon name="seta-cima" /><span>Voltar à superfície</span></a>
      </div>
      <nav class="foot__cols" aria-label="Rodapé">
        <div>
          <h3>Navegue</h3>
          <a href="#sobre">Quem somos</a><a href="#servicos">Serviços</a><a href="#metodo">Método</a><a href="#projetos">Projetos</a><a href="#contato">Contato</a>
        </div>
        <div>
          <h3>Redes</h3>
          <a href={site.redes.instagram.url} target="_blank" rel="noopener">Instagram</a>
          <a href={site.redes.linkedin.url} target="_blank" rel="noopener">LinkedIn</a>
          <a href={site.redes.tiktok.url} target="_blank" rel="noopener">TikTok</a>
          <a href={`mailto:${site.email}`}>E-mail</a>
        </div>
      </nav>
    </div>

    <p class="foot__word" aria-hidden="true" data-foot-word>
      <img src={`${base}img/logo.png`} alt="" width="200" height="200" />imar <i>júnior</i>
    </p>

    <div class="foot__bottom">
      <span>© {ano} {site.nome} · Empresa Júnior do Instituto do Mar · Unifesp Baixada Santista</span>
    </div>
  </div>
</footer>

<style>
  .foot { position: relative; z-index: 2; margin-top: clamp(80px, 10vw, 140px); background: var(--bg-1); padding: 40px 0 28px; }
  .foot__wave { position: absolute; left: 0; bottom: calc(100% - 1px); width: 100%; height: 80px; fill: var(--bg-1); }

  .foot__top { display: grid; grid-template-columns: 1.4fr 1fr; gap: 48px; padding: 40px 0 64px; }
  .foot__slogan {
    margin: 0 0 32px; font-family: var(--display); font-weight: 700;
    font-size: clamp(32px, 4vw, 60px); line-height: 1.02; letter-spacing: -.035em; max-width: 16ch;
  }
  .foot__slogan em { font-style: normal; font-weight: 700; color: var(--accent-ink); }
  .foot__cols { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .foot__cols h3 { margin: 0 0 14px; font-family: var(--mono); font-size: 11px; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .foot__cols a { display: block; padding: 5px 0; text-decoration: none; font-weight: 600; transition: color .3s, transform .4s var(--ease-out); }
  .foot__cols a:hover { color: var(--accent-ink); transform: translateX(6px); }

  .foot__word {
    display: flex; align-items: center; gap: .12em; margin: 0; white-space: nowrap;
    font-family: var(--display); font-weight: 700;
    font-size: clamp(56px, 15.5vw, 260px); line-height: .9; letter-spacing: -.06em;
  }
  .foot__word img { width: .78em; height: .78em; }
  .foot__word i { font-weight: 300; color: var(--accent-ink); }

  .foot__bottom {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-top: 32px; padding-top: 20px; border-top: 1px solid var(--line);
    font-family: var(--mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted);
  }
  @media (max-width: 860px) { .foot__top { grid-template-columns: 1fr; } }
</style>
