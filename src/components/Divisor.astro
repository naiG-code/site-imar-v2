---
/*
 * Divisória entre seções com elementos do mar (usada só na página inicial).
 * Desenho parado (sem animação), só para marcar a passagem entre as seções.
 * Variações: 'cardume' (peixes para a direita), 'bolhas', 'contracorrente' (peixes para a esquerda).
 */
interface Props { tipo?: 'cardume' | 'bolhas' | 'contracorrente' }
const { tipo = 'cardume' } = Astro.props

// Peixe: corpo + cauda, desenhado olhando para a direita
const peixe = 'M30 12 C 24 2, 10 2, 4 12 C 10 22, 24 22, 30 12 Z M4 12 L-6 4 L-4 12 L-6 20 Z'
const onda = 'M0 60 C 120 30 240 30 360 60 S 600 90 720 60 S 960 30 1080 60 S 1320 90 1440 60'
const onda2 = 'M0 70 C 140 50 260 50 380 70 S 640 95 760 70 S 1000 45 1120 70 S 1340 92 1440 70'
// x = posição na largura, y = altura (de baixo para cima), r = raio
const bolhas = [
  { x: 14, y: 18, r: 7 }, { x: 16, y: 52, r: 4 }, { x: 18, y: 72, r: 2.5 },
  { x: 49, y: 22, r: 9 }, { x: 52, y: 60, r: 5 }, { x: 50, y: 82, r: 3 },
  { x: 83, y: 26, r: 6.5 }, { x: 86, y: 58, r: 4 }, { x: 84, y: 78, r: 2.5 },
]
---

<div class:list={['div-mar', `div-mar--${tipo}`]} data-divisor={tipo} aria-hidden="true">
  <svg class="div-mar__ondas" viewBox="0 0 1440 120" preserveAspectRatio="none">
    <path class="div-mar__onda" d={onda} />
    {tipo !== 'cardume' && <path class="div-mar__onda div-mar__onda--2" d={onda2} />}
  </svg>

  {tipo === 'cardume' && (
    <div class="div-mar__nado" style="--px:58%">
      <svg class="div-mar__peixe" style="--s:1" viewBox="-8 0 40 24"><path d={peixe} /></svg>
      <svg class="div-mar__peixe" style="--s:.7; --dy:-26px; --dx:-40px" viewBox="-8 0 40 24"><path d={peixe} /></svg>
      <svg class="div-mar__peixe" style="--s:.55; --dy:22px; --dx:-70px" viewBox="-8 0 40 24"><path d={peixe} /></svg>
    </div>
  )}

  {tipo === 'contracorrente' && (
    <div class="div-mar__nado div-mar__nado--volta" style="--px:38%">
      <svg class="div-mar__peixe" style="--s:.9" viewBox="-8 0 40 24"><path d={peixe} /></svg>
      <svg class="div-mar__peixe" style="--s:.6; --dy:20px; --dx:46px" viewBox="-8 0 40 24"><path d={peixe} /></svg>
    </div>
  )}

  {tipo === 'bolhas' && bolhas.map((b) => (
    <span class="div-mar__bolha" style={`--x:${b.x}%; --y:${b.y}%; --r:${b.r}px`}></span>
  ))}
</div>

<style>
  .div-mar { position: relative; z-index: 1; height: clamp(90px, 12vw, 150px); overflow: hidden; pointer-events: none; }
  .div-mar__ondas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .div-mar__onda {
    fill: none; stroke: var(--accent); stroke-width: 1.6; stroke-linecap: round; opacity: .45;
    vector-effect: non-scaling-stroke;
  }
  .div-mar__onda--2 { opacity: .25; }

  /* Peixes parados, levemente inclinados como se estivessem nadando */
  .div-mar__nado { position: absolute; left: var(--px, 50%); top: 50%; width: 1px; height: 1px; }
  .div-mar__peixe {
    position: absolute; left: var(--dx, 0); top: var(--dy, 0); width: calc(58px * var(--s)); max-width: none; height: auto;
    fill: var(--accent); opacity: .75; translate: 0 -50%; rotate: -4deg;
  }
  .div-mar__nado--volta .div-mar__peixe { scale: -1 1; }

  /* Bolhas paradas, em pequenas colunas */
  .div-mar__bolha {
    position: absolute; left: var(--x); bottom: var(--y); width: calc(var(--r) * 2); height: calc(var(--r) * 2);
    border-radius: 50%; border: 1.5px solid var(--accent); background: color-mix(in srgb, var(--accent) 10%, transparent); opacity: .6;
  }

</style>
