---
import Icon from './Icon.astro'
import { hero } from '../data/conteudo'
---

<section class="hero" id="topo" data-hero>
  <canvas class="hero__ocean" data-ocean aria-hidden="true"></canvas>
  <div class="hero__veil" aria-hidden="true"></div>


  <div class="hero__content wrap">
    <h1 class="display hero__title" data-hero-title>
      <span class="hero__line"><span class="hero__in">{hero.linha1}</span></span>
      <span class="hero__line"><span class="hero__in">
        {hero.linha2}{' '}
        <span class="hero__rotator" data-rotator>
          {hero.palavras.map((p, i) => <em class:list={[{ 'is-on': i === 0 }]} aria-hidden={i !== 0 ? 'true' : undefined}>{p}</em>)}
        </span>
      </span></span>
      <span class="hero__line"><span class="hero__in">{hero.linha3}</span></span>
    </h1>

    <div class="hero__bottom">
      <p class="lead" data-hero-in>{hero.texto}</p>
      <div class="hero__ctas" data-hero-in>
        <a class="btn btn--primary" href="#contato" data-magnetic><span>Solicitar diagnóstico</span><Icon name="seta" /></a>
        <a class="btn btn--ghost" href="#servicos" data-magnetic><span>Ver serviços</span></a>
      </div>
    </div>
  </div>

</section>

<style>
  .hero {
    position: relative; min-height: 100svh; display: flex; flex-direction: column; justify-content: flex-end;
    padding: 120px 0 clamp(48px, 7vw, 96px); overflow: hidden;
  }
  .hero__ocean { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; }
  .hero__veil {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      radial-gradient(120% 70% at 50% 0%, transparent 40%, var(--bg-0) 100%),
      linear-gradient(to bottom, transparent 55%, var(--bg-0));
  }


  .hero__content { position: relative; z-index: 2; }
  .hero__title { font-size: clamp(46px, 8.8vw, 156px); margin-bottom: clamp(32px, 4vw, 56px); }
  .hero__line { display: block; overflow: hidden; padding-bottom: .1em; margin-bottom: -.1em; }
  .hero__in { display: inline-block; }
  /* Estado inicial da animação de entrada (com fallback caso o JS falhe) */
  :global(.js) .hero__in { transform: translateY(110%); animation: hero-safe 0s 5s forwards; }
  :global(.js) [data-hero-in] { opacity: 0; animation: hero-safe 0s 5s forwards; }
  :global(.hero-ready) .hero__in, :global(.hero-ready) [data-hero-in] { animation: none; }
  @keyframes hero-safe { to { transform: none; opacity: 1; } }

  .hero__rotator { position: relative; display: inline-grid; vertical-align: top; }
  .hero__rotator em { grid-area: 1 / 1; white-space: nowrap; opacity: 0; }
  .hero__rotator em.is-on { opacity: 1; }

  .hero__bottom {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 32px;
    padding-top: 32px; border-top: 1px solid var(--line);
  }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; }


  @media (max-width: 860px) {
    .hero__bottom { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .hero__ctas .btn { flex: 1 1 100%; }
  }
</style>
