---
import Icon from './Icon.astro'
import { facaParte } from '../data/conteudo'
import { site } from '../data/site'

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---

<section class="fp" id="faca-parte" data-depth-mark="3800">
  <div class="wrap">
    <div class="fp__box" data-reveal>
      <img class="fp__img" src={`${base}img/evento.jpg`} alt="Membros da IMar Júnior em um encontro do Movimento Empresa Júnior" loading="lazy" data-parallax="-12" />
      <div class="fp__shade" aria-hidden="true"></div>
      <div class="fp__content">
        <p class="eyebrow">Processo seletivo</p>
        <h2 class="fp__title">{facaParte.titulo}</h2>
        <p>{facaParte.texto}</p>
        <a class="btn btn--primary" href={site.redes.instagram.url} target="_blank" rel="noopener" data-magnetic>
          <Icon name="instagram" /><span>Seguir {site.redes.instagram.usuario}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .fp { position: relative; z-index: 2; padding: clamp(40px, 6vw, 80px) 0; }
  .fp__box { position: relative; border-radius: calc(var(--radius) + 8px); overflow: hidden; min-height: 520px; display: flex; align-items: flex-end; }
  .fp__img { position: absolute; inset: 0; width: 100%; height: 125%; object-fit: cover; }
  .fp__shade { position: absolute; inset: 0; background: linear-gradient(100deg, rgba(1, 8, 20, .92) 20%, rgba(1, 8, 20, .45) 65%, rgba(1, 8, 20, .2)); }
  .fp__content { position: relative; padding: clamp(28px, 5vw, 64px); max-width: 640px; color: #eaf4fb; }
  .fp__content .eyebrow { color: #a9c3dc; }
  .fp__title {
    margin: 0 0 18px; font-family: var(--display); font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144; font-weight: 400;
    font-size: clamp(40px, 5.4vw, 80px); line-height: .98; letter-spacing: -.04em;
  }
  .fp__content p { color: #c3d5e8; margin: 0 0 28px; }
  .fp__content .btn--primary::before { background: #eaf4fb; }
  .fp__content .btn--primary:hover { color: #02121f; }
</style>
