---
import { sobre, valores } from '../data/conteudo'

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---

<section class="section sobre" id="sobre">
  <div class="wrap">

    <div class="sobre__grid">
      <figure class="sobre__photo" data-wave-reveal>
        <img src={`${base}img/equipe.jpg`} alt="Equipe da IMar Júnior reunida segurando a bandeira da empresa" width="1400" height="1050" loading="lazy" />
      </figure>

      <div class="sobre__text">
        <h2 class="h2" data-split set:html={sobre.titulo.replace(/\[(.+?)\]/, '<em>$1</em>')} />
        {sobre.texto.map((t) => <p class="muted" data-reveal>{t}</p>)}
        <ul class="sobre__cursos" data-reveal>
          {sobre.cursos.map((c) => <li><b>{c.sigla}</b> {c.nome}</li>)}
        </ul>
      </div>
    </div>

    <h2 class="h2 sobre__mv-titulo" data-split>O que nos <em>move</em></h2>
    <div class="sobre__mv">
      <article class="card" data-reveal>
        <span class="tag">Missão</span>
        <p>{sobre.missao}</p>
      </article>
      <article class="card" data-reveal>
        <span class="tag">Visão</span>
        <p>{sobre.visao}</p>
      </article>
      <article class="card" data-reveal>
        <span class="tag">Valores</span>
        <ul>{valores.map((v) => <li>{v}</li>)}</ul>
      </article>
    </div>
  </div>
</section>

<style>

  .sobre__grid {
    display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: center;
  }
  .sobre__photo { position: relative; margin: 0; border-radius: var(--radius); overflow: hidden; aspect-ratio: 4 / 4.4; }
  .sobre__photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; }
  .sobre__text p { margin: 0 0 18px; max-width: 52ch; }
  .sobre__cursos { list-style: none; padding: 0; margin: 32px 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; }
  .sobre__cursos li { padding: 16px 18px; background: var(--bg-0); font-size: 14px; color: var(--muted); }
  .sobre__cursos b { display: block; font-family: var(--mono); font-size: 12px; letter-spacing: .1em; color: var(--accent-ink); font-weight: 600; }

  .sobre__mv-titulo { margin: clamp(80px, 10vw, 140px) 0 clamp(28px, 4vw, 48px); }
  .sobre__mv { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .card {
    position: relative; padding: clamp(24px, 3vw, 40px); border-radius: var(--radius);
    border: 1px solid var(--line);
    /* Mesma cor nos três cards (missão, visão e valores) */
    background: color-mix(in srgb, var(--accent) 12%, var(--bg-0));
  }
  .card p { margin: 22px 0 0; font-size: 17px; font-weight: 500; color: var(--ink); }
  .card ul { list-style: none; padding: 0; margin: 22px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .card ul li {
    font-family: var(--display); font-weight: 700; font-size: 22px; letter-spacing: -.02em;
  }
  .card ul li:not(:last-child)::after { content: ' ·'; color: var(--accent-ink); }

  @media (max-width: 960px) {
    .sobre__grid, .sobre__mv { grid-template-columns: 1fr; }
  }
</style>
