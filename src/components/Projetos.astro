---
import Marquee from './Marquee.astro'
import { projetos } from '../data/conteudo'

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---

<section class="section projetos" id="projetos">
  <div class="wrap">
    <h2 class="h2" data-split>Ciência aplicada, perto da <em>comunidade</em> e do mar.</h2>

    <div class="proj__list">
      {projetos.map((p, i) => (
        <article class:list={['proj', { 'proj--flip': i % 2 === 1 }]}>
          <figure class="proj__media" data-wave-reveal>
            {p.imagem ? (
              <img src={`${base}${p.imagem}`} alt={p.alt ?? ''} loading="lazy" />
            ) : (
              <div class="proj__art" aria-hidden="true">
                <svg viewBox="0 0 400 300" preserveAspectRatio="none">
                  {[0, 1, 2, 3, 4, 5].map((k) => (
                    <path d={`M0 ${80 + k * 36} C 80 ${50 + k * 36}, 160 ${110 + k * 36}, 240 ${80 + k * 36} S 360 ${50 + k * 36}, 400 ${80 + k * 36}`} style={`--k:${k}`} />
                  ))}
                </svg>
                <span>Foto em breve</span>
              </div>
            )}
          </figure>
          <div class="proj__text" data-reveal>
            <div class="proj__meta"><span class="tag">{p.tag}</span><span class="proj__local">{p.local}</span></div>
            <h3 class="proj__title">{p.titulo}</h3>
            <p class="muted">{p.texto}</p>
            <p class="proj__parc">{p.parceiros}</p>
          </div>
        </article>
      ))}
    </div>
  </div>


  <div class="proj__valores">
    <p class="wrap proj__valores-label">Nossos valores</p>
    <Marquee />
  </div>
</section>

<style>
  .proj__valores { margin-top: clamp(96px, 12vw, 180px); }
  .proj__valores-label {
    margin-bottom: 18px; font-family: var(--mono); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted);
  }
  .proj__list { display: grid; gap: clamp(80px, 10vw, 160px); margin-top: clamp(56px, 7vw, 100px); }
  .proj { display: grid; grid-template-columns: 1.25fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .proj--flip .proj__media { order: 2; }

  .proj__media { margin: 0; position: relative; aspect-ratio: 16 / 11; border-radius: var(--radius); overflow: hidden; background: var(--card); }
  .proj__media img { width: 100%; height: 100%; object-fit: cover; }
  .proj__art {
    position: absolute; inset: 0; display: grid; place-items: center;
    background: radial-gradient(120% 120% at 20% 0%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 60%),
      linear-gradient(160deg, var(--wave-3), var(--bg-1));
  }
  .proj__art svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .proj__art path {
    fill: none; stroke: rgba(200, 240, 255, .35); stroke-width: 1.2;
    animation: sway 6s ease-in-out infinite alternate; animation-delay: calc(var(--k) * -.7s);
  }
  @keyframes sway { from { transform: translateX(-30px); } to { transform: translateX(30px); } }
  .proj__art span {
    position: relative; font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: #eaf4fb;
    padding: 8px 14px; border: 1px solid rgba(234, 244, 251, .35); border-radius: 999px;
  }

  .proj__meta { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .proj__local { font-family: var(--mono); font-size: 12px; color: var(--muted); }
  .proj__title {
    margin: 22px 0 18px; font-family: var(--display); font-weight: 700;
    font-size: clamp(40px, 5vw, 80px); line-height: .98; letter-spacing: -.04em;
  }
  .proj__text p { max-width: 48ch; }
  .proj__parc { font-family: var(--mono); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--accent-ink); }


  @media (max-width: 900px) {
    .proj { grid-template-columns: 1fr; }
    .proj--flip .proj__media { order: 0; }
  }
</style>
