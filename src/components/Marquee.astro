---
import { valores } from '../data/conteudo'

interface Props {
  items?: string[]
  reverse?: boolean
  outline?: boolean
}
const { items = valores, reverse = false, outline = false } = Astro.props
const seq = [...items, ...items]
---

<div class:list={['marquee', { 'marquee--outline': outline }]} data-marquee data-dir={reverse ? -1 : 1} aria-hidden="true">
  <div class="marquee__track" data-marquee-track>
    {[0, 1].map(() => (
      <div class="marquee__group">
        {seq.map((v) => (
          <span class="marquee__item">{v}<svg viewBox="0 0 24 24"><path d="M2 12c3-4 6-4 10 0s7 4 10 0" /></svg></span>
        ))}
      </div>
    ))}
  </div>
</div>
<p class="sr-only">{items.join(', ')}</p>

<style>
  .marquee { position: relative; z-index: 2; overflow: hidden; padding: 20px 0; border-block: 1px solid var(--line); }
  .marquee__track { display: flex; width: max-content; will-change: transform; }
  .marquee__group { display: flex; flex-shrink: 0; }
  .marquee__item {
    display: inline-flex; align-items: center; gap: clamp(20px, 3vw, 44px); padding-right: clamp(20px, 3vw, 44px);
    font-family: var(--display); font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144;
    font-style: italic; font-weight: 300; font-size: clamp(36px, 6vw, 96px); line-height: 1.1; letter-spacing: -.03em;
    white-space: nowrap;
  }
  .marquee--outline .marquee__item { color: transparent; -webkit-text-stroke: 1px var(--line-2); font-style: normal; font-weight: 600; }
  .marquee__item svg { width: clamp(28px, 3vw, 48px); fill: none; stroke: var(--accent); stroke-width: 1.6; stroke-linecap: round; }
</style>
