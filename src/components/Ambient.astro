---
/* Elementos fixos: partículas, profundímetro, cursor e botão de WhatsApp. */
import Icon from './Icon.astro'
import { whatsappLink } from '../data/site'
---

<canvas class="snow" data-snow aria-hidden="true"></canvas>

<div class="gauge" aria-hidden="true">
  <div class="gauge__track"><i data-gauge-bar></i></div>
  <div class="gauge__read">
    <span class="gauge__label">Prof.</span>
    <span class="gauge__value"><b data-depth>0000</b> m</span>
    <span class="gauge__zone" data-zone>Epipelágica</span>
  </div>
</div>

<div class="cursor" data-cursor aria-hidden="true"><span data-cursor-label></span></div>

<a class="wpp" href={whatsappLink()} target="_blank" rel="noopener" aria-label="Conversar no WhatsApp" data-magnetic>
  <Icon name="whatsapp" size={26} />
  <span class="wpp__tip">Fale com a gente</span>
</a>

<style>
  .snow { position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1; }

  /* Profundímetro: fica na margem esquerda, na vertical */
  .gauge {
    position: fixed; left: calc(var(--gutter) / 2 - 6px); top: 50%; z-index: 90; transform: translateY(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 16px; pointer-events: none;
    font-family: var(--mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted);
    opacity: 0; transition: opacity .6s;
  }
  :global(.depth-on) .gauge { opacity: 1; }
  .gauge__track { position: relative; width: 1px; height: 120px; background: var(--line-2); }
  .gauge__track i {
    position: absolute; left: -3px; top: 0; width: 7px; height: 7px; border-radius: 50%;
    background: var(--accent); box-shadow: 0 0 14px var(--accent);
  }
  .gauge__read { display: flex; gap: 10px; writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; }
  .gauge__label { display: none; }
  .gauge__value { color: var(--ink); letter-spacing: .06em; }
  .gauge__value b { font-weight: 500; font-variant-numeric: tabular-nums; }
  .gauge__zone { color: var(--accent-ink); }
  @media (max-width: 1100px) { .gauge { display: none; } }

  .cursor {
    position: fixed; left: 0; top: 0; z-index: 1000; pointer-events: none;
    width: 14px; height: 14px; margin: -7px 0 0 -7px; border-radius: 50%;
    border: 1px solid var(--accent); background: color-mix(in srgb, var(--accent) 12%, transparent);
    display: grid; place-items: center; opacity: 0;
    transition: width .45s var(--ease-out), height .45s var(--ease-out), margin .45s var(--ease-out), opacity .3s, background-color .3s;
  }
  :global(.has-cursor) .cursor { opacity: 1; }
  .cursor.is-hover { width: 64px; height: 64px; margin: -32px 0 0 -32px; background: color-mix(in srgb, var(--accent) 18%, transparent); }
  .cursor.is-label { width: 96px; height: 96px; margin: -48px 0 0 -48px; background: var(--accent); }
  .cursor span {
    font-family: var(--mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--on-accent);
    opacity: 0; transition: opacity .3s;
  }
  .cursor.is-label span { opacity: 1; }
  @media (hover: none), (pointer: coarse) { .cursor { display: none; } }

  .wpp {
    position: fixed; right: 20px; bottom: 20px; z-index: 95;
    display: grid; place-items: center; width: 60px; height: 60px; border-radius: 50%;
    background: #25d366; color: #04210f; text-decoration: none;
    box-shadow: 0 14px 40px -10px rgba(37, 211, 102, .6);
  }
  .wpp::before {
    content: ''; position: absolute; inset: 0; border-radius: 50%; border: 2px solid #25d366;
    animation: wpp-ring 2.6s var(--ease) infinite;
  }
  @keyframes wpp-ring { from { transform: scale(1); opacity: .8; } to { transform: scale(1.7); opacity: 0; } }
  .wpp__tip {
    position: absolute; right: 72px; white-space: nowrap; padding: 8px 14px; border-radius: 999px;
    background: var(--ink); color: var(--bg-0); font-size: 13px; font-weight: 650;
    opacity: 0; transform: translateX(8px); transition: opacity .35s, transform .45s var(--ease-out); pointer-events: none;
  }
  .wpp:hover .wpp__tip { opacity: 1; transform: none; }
</style>
