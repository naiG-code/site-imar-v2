---
/* Botão flutuante de WhatsApp. */
import Icon from './Icon.astro'
import { whatsappLink } from '../data/site'
---

<a class="wpp" href={whatsappLink()} target="_blank" rel="noopener" aria-label="Conversar no WhatsApp" data-magnetic>
  <Icon name="whatsapp" size={26} />
  <span class="wpp__tip">Fale com a gente</span>
</a>

<style>
  .wpp {
    position: fixed; right: 20px; bottom: 20px; z-index: 95;
    display: grid; place-items: center; width: 60px; height: 60px; border-radius: 50%;
    background: #25d366; color: #04210f; text-decoration: none;
    box-shadow: 0 14px 40px -10px rgba(37, 211, 102, .6);
  }
  .wpp::before {
    content: ''; position: absolute; inset: 0; border-radius: 50%; border: 2px solid #25d366;
    animation: wpp-ring 2.6s var(--ease) infinite;
  }
  @keyframes wpp-ring { from { transform: scale(1); opacity: .8; } to { transform: scale(1.7); opacity: 0; } }
  .wpp__tip {
    position: absolute; right: 72px; white-space: nowrap; padding: 8px 14px; border-radius: 999px;
    background: var(--ink); color: var(--bg-0); font-size: 13px; font-weight: 650;
    opacity: 0; transform: translateX(8px); transition: opacity .35s, transform .45s var(--ease-out); pointer-events: none;
  }
  .wpp:hover .wpp__tip { opacity: 1; transform: none; }
</style>
