---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---

<div class="preloader" data-preloader aria-hidden="true">
  <div class="preloader__inner">
    <div class="preloader__mark">
      <img class="preloader__ghost" src={`${base}img/logo-mark.png`} alt="" width="120" height="120" />
      <div class="preloader__fill" data-preloader-fill>
        <img src={`${base}img/logo-mark.png`} alt="" width="120" height="120" />
      </div>
    </div>
    <p class="preloader__label"><span>Calibrando o sonar</span><span data-preloader-count>000</span></p>
  </div>
  <svg class="preloader__wave" viewBox="0 0 1440 160" preserveAspectRatio="none">
    <path data-preloader-wave d="M0 0 L0 80 C 240 160 480 160 720 80 C 960 0 1200 0 1440 80 L1440 0 Z" />
  </svg>
</div>

<style>
  .preloader { display: none; }
  :global(.js) .preloader {
    position: fixed; inset: 0; z-index: 900; display: grid; place-items: center;
    background: var(--bg-0);
    animation: preloader-safety 0s linear 6s forwards; /* se o JS falhar, some sozinho */
  }
  @keyframes preloader-safety { to { visibility: hidden; } }
  :global(.js.ja-visitou) .preloader { display: none; }

  .preloader__inner { display: grid; justify-items: center; gap: 28px; }
  .preloader__mark { position: relative; width: 120px; height: 120px; }
  .preloader__ghost { opacity: .12; filter: grayscale(1); }
  .preloader__fill { position: absolute; inset: 0; clip-path: inset(100% 0 0 0); }
  .preloader__label {
    display: flex; gap: 18px; margin: 0;
    font-family: var(--mono); font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--muted);
  }
  .preloader__label span:last-child { color: var(--accent-ink); min-width: 3ch; }
  .preloader__wave {
    position: absolute; left: 0; top: 100%; width: 100%; height: 160px; fill: var(--bg-0);
  }
</style>
