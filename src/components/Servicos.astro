---
import Icon from './Icon.astro'
import ServicoIcone from './ServicoIcone.astro'
import { servicos } from '../data/servicos'
import { publicos } from '../data/conteudo'
import { url, contatoServico } from '../lib/rotas'

// Para cada serviço, a lista de públicos que ele atende (usada pelo filtro)
const publicosDe = (id: string) =>
  publicos.filter((p) => p.servicos.includes(id)).map((p) => p.id).join(' ')
const todos = publicos[0]
---

<section class="servicos" id="servicos">
  <div class="wrap" data-filtro>
    <header class="servicos__head">
      <h2 class="h2 servicos__titulo" data-reveal>
        Soluções ambientais para <span class="servicos__frase"><em data-filtro-frase>{todos.frase}</em></span>
      </h2>
    </header>

    <div class="filtro" data-reveal>
      <p class="filtro__label" id="filtro-label">Você é</p>
      <div class="filtro__pills" role="radiogroup" aria-labelledby="filtro-label">
        {publicos.map((p, i) => (
          <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} class:list={['filtro__pill', { 'is-on': i === 0 }]}
            data-filtro-btn={p.id} data-frase={p.frase} data-texto={p.texto} data-servicos={p.servicos.join(' ')}>
            {p.nome}
          </button>
        ))}
        <span class="filtro__blob" data-filtro-blob aria-hidden="true"></span>
      </div>
      <p class="filtro__texto" data-filtro-texto aria-live="polite">{todos.texto}</p>
    </div>
  </div>

  <div class="car" data-carousel aria-roledescription="carrossel" aria-label="Serviços">
    <button type="button" class="car__arrow car__arrow--prev" data-car-prev aria-label="Serviço anterior"><Icon name="seta" size={22} /></button>
    <button type="button" class="car__arrow car__arrow--next" data-car-next aria-label="Próximo serviço"><Icon name="seta" size={22} /></button>
    <div class="car__track" data-car-track>
      {servicos.map((s, i) => (
        <article class:list={['svc', { 'is-on': i === 0 }]} data-svc data-id={s.id} data-publicos={publicosDe(s.id)} aria-roledescription="slide" aria-label={`${i + 1} de ${servicos.length}: ${s.titulo}`}>
          <ServicoIcone icone={s.icone} class="svc__art" />
          <div class="svc__body">
            <p class="svc__para">{s.paraQuem}{s.selo && <span class="svc__selo">{s.selo}</span>}</p>
            <h3 class="svc__title">{s.titulo}</h3>
            <p class="svc__resumo">{s.resumo}</p>
            <a class="svc__cta" href={contatoServico(s.id)}>Quero esse serviço <Icon name="seta" /></a>
          </div>
        </article>
      ))}
    </div>
  </div>

  <div class="wrap">
    <div class="car__dots" role="tablist" aria-label="Escolher serviço">
      {servicos.map((s, i) => (
        <button type="button" role="tab" class:list={['car__dot', { 'is-on': i === 0 }]} data-car-dot={i} data-id={s.id} aria-label={s.titulo} aria-selected={i === 0 ? 'true' : 'false'}>
          <span>{s.titulo}</span><i><b></b></i>
        </button>
      ))}
    </div>
  </div>

  <div class="wrap servicos__mais">
    <a class="btn btn--ghost" href={url('servicos')} data-magnetic><span>Ver todos os serviços</span><Icon name="seta" /></a>
  </div>
</section>

<style>
  .servicos__mais { margin-top: clamp(28px, 3vw, 40px); }
  .servicos { position: relative; z-index: 2; padding-top: clamp(96px, 12vw, 160px); }
  .servicos__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; margin-bottom: clamp(32px, 4vw, 56px); }
  .servicos__head .h2 { margin: 0; }

  /* Setas sobre o carrossel: uma em cada lado, centralizadas na altura dos cards */
  .car { position: relative; }
  .car__arrow {
    position: absolute; top: 50%; z-index: 3; translate: 0 -50%;
    display: grid; place-items: center; width: 60px; height: 60px; border-radius: 50%; cursor: pointer;
    border: 1px solid var(--line-2); color: var(--ink);
    background: color-mix(in oklab, var(--bg-0), transparent 15%);
    box-shadow: 0 12px 30px -12px rgba(0, 0, 0, .6);
    transition: background-color .3s, color .3s, border-color .3s, scale .4s var(--ease-out);
  }
  .car__arrow:hover { background: var(--accent); border-color: var(--accent); color: var(--on-accent); scale: 1.08; }
  .car__arrow--prev { left: calc(var(--pad) - 30px); }
  .car__arrow--next { left: calc(var(--pad) + var(--card-w) - 30px); }
  .car__arrow--prev :global(svg) { transform: rotate(-135deg); }
  .car__arrow--next :global(svg) { transform: rotate(45deg); }

  /* Trilho com rolagem nativa + "snap": desliza leve no dedo e no trackpad */
  .car {
    --pad: max(var(--gutter), calc((100vw - var(--maxw)) / 2 + var(--gutter)));
    --card-w: min(860px, 78vw);
  }
  .car__track {
    display: flex; gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth;
    padding: 4px max(var(--pad), calc(100vw - var(--card-w) - var(--pad))) 4px var(--pad);
    scroll-padding-inline-start: var(--pad);
    scrollbar-width: none; overscroll-behavior-x: contain;
  }
  .car__track::-webkit-scrollbar { display: none; }
  @media (prefers-reduced-motion: reduce) { .car__track { scroll-behavior: auto; } }

  .svc {
    flex: 0 0 var(--card-w); scroll-snap-align: start;
    display: grid; grid-template-columns: auto 1fr; gap: clamp(24px, 4vw, 64px); align-items: center;
    padding: clamp(28px, 4vw, 56px); border-radius: calc(var(--radius) + 6px);
    border: 1px solid var(--line); background: var(--card);
    opacity: .35; transform: scale(.96); transform-origin: left center;
    transition: opacity .6s var(--ease-out), transform .8s var(--ease-out), border-color .6s, background-color .6s;
  }
  .svc.is-on {
    opacity: 1; transform: none; border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: linear-gradient(150deg, color-mix(in srgb, var(--accent) 12%, transparent), var(--card) 55%);
  }
  .svc :global(.svc__art) {
    width: clamp(96px, 14vw, 180px); height: auto; aspect-ratio: 1; fill: none; stroke: var(--accent-ink); stroke-width: 1.3;
    stroke-linecap: round; stroke-linejoin: round;
  }
  .svc__para {
    display: flex; align-items: center; flex-wrap: wrap; gap: 12px; margin: 0 0 14px;
    font-family: var(--mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--accent-ink);
  }
  .svc__selo { padding: 5px 10px; border-radius: 999px; background: var(--accent); color: var(--on-accent); font-weight: 600; }
  .svc__title {
    margin: 0; font-family: var(--display); font-weight: 700;
    font-size: clamp(32px, 4vw, 60px); line-height: 1; letter-spacing: -.035em;
  }
  .svc__resumo { margin: 18px 0 28px; color: var(--muted); max-width: 46ch; }
  .svc__cta {
    display: inline-flex; align-items: center; gap: 10px; padding: 13px 20px; border-radius: 999px; border: 1px solid var(--line-2);
    font-size: 14px; font-weight: 650; text-decoration: none; transition: background-color .3s, color .3s, border-color .3s;
  }
  .svc__cta:hover { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }

  /* Indicadores: nome do serviço + barra que enche durante a troca automática */
  .car__dots { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 12px; margin-top: 28px; }
  .car__dot {
    display: grid; gap: 10px; padding: 0; border: 0; background: none; cursor: pointer; text-align: left;
    font-size: 13px; font-weight: 600; color: var(--muted); transition: color .3s;
  }
  .car__dot span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .car__dot:hover, .car__dot.is-on { color: var(--ink); }
  .car__dot i { position: relative; display: block; height: 2px; border-radius: 2px; background: var(--line-2); overflow: hidden; }
  .car__dot b { position: absolute; inset: 0; background: var(--accent); transform-origin: left; transform: scaleX(0); }
  .car__dot.is-done b { transform: scaleX(1); }

  @media (max-width: 760px) {
    .servicos__head { align-items: flex-start; flex-direction: column; }
    .car__arrow { width: 38px; height: 38px; }
    .car__arrow :global(svg) { width: 16px; height: 16px; }
    .car__arrow--prev { left: max(0px, calc(var(--pad) - 19px)); }
    .car__arrow--next { left: calc(var(--pad) + var(--card-w) - 19px); }
    .car { --card-w: 86vw; }
    .svc { grid-template-columns: 1fr; gap: 20px; }
    .svc :global(.svc__art) { width: 80px; }
    .car__dots { gap: 6px; }
    .car__dot span { display: none; }
  }

  /* ---------- Para quem ---------- */
  /* ---------- Filtro "Você é" ---------- */
  .servicos__titulo { max-width: 20ch; }
  .servicos__frase { display: inline-block; }
  .servicos__frase em { display: inline-block; }

  .filtro { display: flex; align-items: center; flex-wrap: wrap; gap: 14px 24px; margin-bottom: clamp(28px, 3vw, 44px); }
  .filtro__label { margin: 0; font-family: var(--mono); font-size: 12px; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .filtro__pills {
    position: relative; display: flex; flex-wrap: wrap; gap: 4px; padding: 5px; border-radius: 999px;
    border: 1px solid var(--line); background: var(--card);
  }
  .filtro__pill {
    position: relative; z-index: 1; padding: 10px 18px; border: 0; border-radius: 999px; background: none; cursor: pointer;
    font-size: 14px; font-weight: 600; color: var(--muted); transition: color .4s;
  }
  .filtro__pill:hover { color: var(--ink); }
  .filtro__pill.is-on { color: var(--on-accent); }
  /* "Bolha" que desliza até o público escolhido */
  .filtro__blob {
    position: absolute; z-index: 0; left: 0; top: 0; border-radius: 999px; background: var(--accent);
    transition: transform .6s var(--ease-out), width .6s var(--ease-out), height .6s var(--ease-out);
  }
  :global(html:not(.js)) .filtro__pill.is-on { background: var(--accent); }
  .filtro__texto { flex-basis: 100%; margin: 0; color: var(--muted); max-width: 60ch; }

  .svc.is-out { display: none; }
  .car__dot.is-out { display: none; }

  @media (max-width: 760px) {
    .filtro__pills { border-radius: 22px; }
  }
</style>
