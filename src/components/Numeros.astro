---
/* Números da IMar (contam de 0 até o valor quando aparecem na tela). Edite em src/data/conteudo.ts */
import Icon from './Icon.astro'
import { numeros, apresentacao } from '../data/conteudo'
import { url } from '../lib/rotas'

/* comApresentacao: frase sobre a IMar + botão para Quem somos (usado na página inicial) */
interface Props { comApresentacao?: boolean }
const { comApresentacao = false } = Astro.props

const lista = numeros.filter((n) => n.confirmado || import.meta.env.DEV)
const casas = (v: number) => (Number.isInteger(v) ? 0 : 1)
const formatar = (v: number) => v.toLocaleString('pt-BR', { minimumFractionDigits: casas(v), maximumFractionDigits: casas(v) })
---

{(lista.length > 0 || comApresentacao) && (
  <section class="nums-sec">
    <div class="wrap">
      {comApresentacao && (
        <div class="nums__intro">
          <figure class="nums__foto" data-wave-reveal>
            {apresentacao.imagem ? (
              <img src={url(apresentacao.imagem)} alt={apresentacao.alt} loading="lazy" />
            ) : (
              <div class="nums__vazio" aria-hidden="true">
                <svg viewBox="0 0 400 300" preserveAspectRatio="none">
                  {[0, 1, 2, 3, 4, 5].map((k) => (
                    <path d={`M0 ${80 + k * 36} C 80 ${50 + k * 36}, 160 ${110 + k * 36}, 240 ${80 + k * 36} S 360 ${50 + k * 36}, 400 ${80 + k * 36}`} style={`--k:${k}`} />
                  ))}
                </svg>
                <span>Foto em breve</span>
              </div>
            )}
          </figure>
          <div class="nums__texto">
            <h2 class="h2" data-split>Estudantes do mar, trabalhando em <em>terra firme</em>.</h2>
            <div data-reveal>
              <p class="lead">Somos a Empresa Júnior do Instituto do Mar da Unifesp. Desde 2015, unimos ciência e prática para gerar impacto na sociedade e no meio ambiente.</p>
              <a class="btn btn--ghost" href={url('quem-somos')} data-magnetic><span>Conheça a IMar Júnior</span><Icon name="seta" /></a>
            </div>
          </div>
        </div>
      )}
      <dl class="sobre__nums" style={`--n:${lista.length}`}>
        {lista.map((n) => (
          <div data-reveal>
            <dt>{n.rotulo}{!n.confirmado && <span class="nums__ex">exemplo</span>}</dt>
            <dd>{n.prefixo}<span data-count={n.valor} data-casas={casas(n.valor)}>{formatar(n.valor)}</span>{n.sufixo}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
)}

<style>
  .nums-sec { position: relative; z-index: 2; padding: clamp(56px, 8vw, 110px) 0; }
  /* Apresentação: foto + texto, bem separados dos números abaixo */
  .nums__intro { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: center; margin-bottom: clamp(80px, 10vw, 150px); }
  .nums__intro .h2 { margin: 0 0 24px; }
  .nums__intro .lead { margin-bottom: 28px; }
  .nums__foto { position: relative; margin: 0; aspect-ratio: 4 / 3; border-radius: var(--radius); overflow: hidden; background: var(--card); }
  .nums__foto img { width: 100%; height: 100%; object-fit: cover; }
  .nums__vazio {
    position: absolute; inset: 0; display: grid; place-items: center;
    background: radial-gradient(120% 120% at 20% 0%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 60%), linear-gradient(160deg, var(--wave-3), var(--bg-1));
  }
  .nums__vazio svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .nums__vazio path { fill: none; stroke: rgba(255, 255, 255, .4); stroke-width: 1.2; animation: nums-mar 6s ease-in-out infinite alternate; animation-delay: calc(var(--k) * -.7s); }
  @keyframes nums-mar { from { transform: translateX(-30px); } to { transform: translateX(30px); } }
  .nums__vazio span {
    position: relative; padding: 8px 14px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, .5);
    font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: #fff;
  }
  @media (max-width: 860px) { .nums__intro { grid-template-columns: 1fr; } }
  .sobre__nums {
    display: grid; grid-template-columns: repeat(var(--n, 4), 1fr); margin: 0;
    border-top: 1px solid var(--line);
  }
  .sobre__nums div { display: flex; flex-direction: column; padding: 28px 20px 0 0; }
  .sobre__nums div + div { padding-left: 20px; border-left: 1px solid var(--line); }
  .sobre__nums dt { font-family: var(--mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .nums__ex {
    margin-left: 8px; padding: 2px 7px; border-radius: 999px; border: 1px dashed var(--accent-ink);
    color: var(--accent-ink); font-size: 9px; vertical-align: middle;
  }
  .sobre__nums dd {
    margin: auto 0 0; padding-top: 10px; font-family: var(--display); font-weight: 700;
    font-size: clamp(44px, 5.8vw, 96px); line-height: 1; letter-spacing: -.04em; font-variant-numeric: tabular-nums;
  }

  @media (max-width: 960px) {
    .sobre__nums { grid-template-columns: 1fr 1fr; row-gap: 32px; }
    .sobre__nums div:nth-child(3) { padding-left: 0; border-left: 0; }
  }
</style>
